# Local dev Caddyfile — test the full prod setup on http://localhost.
#
# Usage:
#   caddy run --config deploy/Caddyfile.dev
#
# Then hit http://localhost:2015 in your browser. Requires that the Go API
# is running on :8080 and that the React app has been built to frontend/dist.
{
	# No automatic HTTPS for local testing.
	auto_https off
	admin localhost:2020
}

:2015 {
	encode zstd gzip

	# Same API reverse proxy as prod.
	handle_path /api/* {
		rewrite * /api{uri}
		reverse_proxy localhost:8080
	}

	# Serve the built frontend from frontend/dist — run `pnpm build` first.
	handle {
		root * ./frontend/dist
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
